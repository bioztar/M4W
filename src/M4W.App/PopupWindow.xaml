<Window x:Class="M4W.App.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M4W" Width="520" Height="460"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="#1E1F24" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#ECECEC" />
        <SolidColorBrush x:Key="Dim" Color="#8A8D96" />
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="4,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33507F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#3A3C45" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,10,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Padding="8,6" Background="#2A2C33" Foreground="{StaticResource Fg}"
                         CaretBrush="{StaticResource Fg}" BorderBrush="#3A3C45" TextChanged="OnSearchChanged" />
                <CheckBox x:Name="ExactToggle" Grid.Column="1" Content="Exact" Margin="10,0,0,0"
                          VerticalAlignment="Center" Foreground="{StaticResource Dim}" Focusable="False"
                          Checked="OnModeChanged" Unchecked="OnModeChanged"
                          ToolTip="Exact substring instead of fuzzy match (Alt+E)" />
            </Grid>

            <ListBox x:Name="ResultList" Grid.Row="1" Background="Transparent" BorderThickness="0" Focusable="False"
                     VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Thumbnail}" Visibility="{Binding ThumbnailVisibility}"
                                   MaxHeight="56" MaxWidth="120" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Fg}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="📌" Visibility="{Binding PinVisibility}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Margin="12,6,12,8" Foreground="{StaticResource Dim}" FontSize="11"
                       Text="↑↓ select · Enter paste · Alt+P pin · Del remove · Alt+E exact · Esc close" />
        </Grid>
    </Border>
</Window>
